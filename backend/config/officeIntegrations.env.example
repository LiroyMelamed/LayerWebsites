# Add to the backend's secret environment; never commit populated values.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Exactly 64 hex characters (32 random bytes). Keep a backed-up secret; changing
# it without re-encrypting saved grants requires every office to reconnect.
INTEGRATIONS_ENCRYPTION_KEY=
# Keep both false for demo/QA. Also respects BACKGROUND_JOBS_ENABLED.
WHATSAPP_LIVE_ENABLED=false
WHATSAPP_WORKER_ENABLED=false
# QA can simulate new-case groups even with BACKGROUND_JOBS_ENABLED=false.
# Both must be true; DEMO_ONLY blocks every Meta request and live activation.
WHATSAPP_DEMO_ONLY=false
WHATSAPP_DEMO_WORKER_ENABLED=false
# Real signup, health checks and the required coexistence handshake; blocks all
# group/message delivery even if LIVE_ENABLED is accidentally enabled.
WHATSAPP_CONNECT_ONLY=false
# business_app selects Meta's official WhatsApp Business app / QR signup (v4).
# Requires Tech Provider approval and account_update/history/smb_app_state_sync/
# smb_message_echoes subscriptions. This integration retains sync status only,
# never contacts, messages or history. It is not a WhatsApp inbox.
WHATSAPP_SIGNUP_FLOW=cloud
# Daily synthetic court imports at each office's saved Israel-local time.
# Safe to run independently of the delivery/background schedulers.
COURT_DEMO_SYNC_WORKER_ENABLED=false
# QA only: preserve synthetic court updates on cases created using the normal form.
# Independent of enabling real WhatsApp authorization in connection-only QA.
COURT_DEMO_CASE_LINKING=false
