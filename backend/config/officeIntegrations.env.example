# Add to the backend's secret environment; never commit populated values.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Exactly 64 hex characters (32 random bytes). Keep a backed-up secret; changing
# it without re-encrypting saved grants requires every office to reconnect.
INTEGRATIONS_ENCRYPTION_KEY=
# Keep both false for demo/QA. Also respects BACKGROUND_JOBS_ENABLED.
WHATSAPP_LIVE_ENABLED=false
WHATSAPP_WORKER_ENABLED=false
# QA can simulate new-case groups even with BACKGROUND_JOBS_ENABLED=false.
# Both must be true; DEMO_ONLY blocks every Meta request and live activation.
WHATSAPP_DEMO_ONLY=false
WHATSAPP_DEMO_WORKER_ENABLED=false
