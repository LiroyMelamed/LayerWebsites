  "narrative": {
    "northStar": "The Legal Office Daybook",
    "overview": "This is a scoped record of the implemented calendar, including its compact home widget. It inherits the platform's navy palette, Heebo typography, shared controls and tenant identity. The name describes the existing operational character; it introduces no replacement brand.\n\nThe day surface uses an airy time rail and appointment cards. Week and month preserve planning density while keeping a path to the selected day's details. Owner portraits or initials tie appointments to the responsible team members. This record describes source behavior, cross-checked against the final desktop-day, mobile-week and mobile-month captures under `outputs/calendar-release-20261012/browser-final-v3` in the parent workspace. The capture set also includes desktop-week, desktop-month and mobile-day; this document does not certify browser, Figma or native approval. Figma and native verification remain pending normal Mac unlock.",
    "keyCharacteristics": [
      "Familiar navy selection on white and cool gray surfaces.",
      "Readable daily cards with compact planning alternatives.",
      "Owner portraits or initials, translated labels and directional layout.",
      "Shared platform buttons, fields, segmented navigation and popups."
    ],
    "rules": [
      {
        "name": "The Selection Continuity Rule",
        "body": "Selected controls use navy with white content across owner filters, the day ribbon and mobile month selection.",
        "section": "colors"
      },
      {
        "name": "The Detail Recovery Rule",
        "body": "Compact representations keep a route to the day's agenda or event modal, where the full event title is available. The event modal's full-title block wraps anywhere and is not line-clamped.",
        "section": "typography"
      },
      {
        "name": "The Stable Planning Surface Rule",
        "body": "Calendar and filter containers stay fixed on hover; compact meeting rows carry no independent elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do inherit the platform's navy, Heebo, shared components and tenant identity.",
      "Do preserve calendar logic, permissions, translated text and existing editing/sync workflows.",
      "Do retain owner identity and provide a detailed path from compact planning representations.",
      "Do keep keyboard focus, directional layout and reduced-motion behavior visible in new calendar surfaces.",
      "Do use unboxed compact rows inside week day containers and rounded navy selected dates on phones."
    ],
    "donts": [
      "Don't turn this calendar record into a replacement platform identity or a root-level design policy.",
      "Don't promote compact-grid clipping, tiny labels or avatar suppression into general rules for detail views.",
      "Don't replace shared navigation and form primitives with unrelated visual components.",
      "Don't use status color as the only available description of response, cancellation or conflict.",
      "Don't claim browser, Figma or native validation from this design record."
    ]
  }
}
